@page "/"
@using System.Diagnostics;
@using System.Net.Sockets;
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Security
@using System.Security.Cryptography.X509Certificates
@using System.Net

<PageTitle>Home</PageTitle>

<h1>Ip Checker Program</h1>

Check the Ip's

<div class="row">
    <InputTextArea class="col-12 w-full p-3 rounded-xl border bg-white/70 focus:ring-2 focus:ring-amber-500 focus:outline-none glass-card" @bind-Value="Ips">
    </InputTextArea>
</div>

<div class="row">
    <center>
        <button @onclick="() => HandleSubmit()" class="btn">Check</button>
    </center>
</div>

<div class="row">
    <h1>Pre</h1>
    <p>
        @((MarkupString)PreResult)
    </p>
</div>

<div class="row">
    <p>
        @((MarkupString)Result)
    </p>
</div>


@code {
    public string? Ips { get; set; }
    public int Port { get; set; } = 443;
    public int TimeOut { get; set; } = 500;
    public string? Result { get; set; }
    public string? PreResult { get; set; }


    private static async Task<long> TcpPingAsync(string ipAddress, int port, int timeoutMs)
    {
        var stopwatch = new Stopwatch();
        using var tcpclient = new TcpClient();
        try
        {
            stopwatch.Start();
            var connectTask = tcpclient.ConnectAsync(ipAddress, port);
            if (await Task.WhenAny(connectTask, Task.Delay(timeoutMs)) == connectTask)
            {
                stopwatch.Stop();
                if (tcpclient.Connected)
                {
                    return stopwatch.ElapsedMilliseconds;
                }
            }
        }
        catch
        {

        }
        return -1;
    }


    private async Task HandleSubmit()
    {
        Result = "";

        if (string.IsNullOrWhiteSpace(Ips)) return;

        List<string> ips = Ips.Split(new[] { ' ', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).ToList();

        foreach (var item in ips)
        {
            long ping = await TcpPingAsync(item, Port, TimeOut);
            Result += $"\n <br /> {item}  ----->  {ping}";

            if (ping != -1)
            {
                string domain = await GetDomainFromIpAsync(item);

                if (domain == "No Domain Found")
                {
                    try
                    {
                        var hostEntry = await Dns.GetHostEntryAsync(item);
                        Result += " /--/ " + hostEntry.HostName; 
                    }
                    catch (SocketException)
                    {
                       
                    }
                }
                else
                {
                    Result += " /--/ " + domain;
                }
            }
            StateHasChanged();
        }
    }

    private static async Task<string> GetDomainFromIpAsync(string ipAddress)
    {
        using var client = new TcpClient();
        try
        {
            await client.ConnectAsync(ipAddress, 443);

            using var sslStream = new SslStream(client.GetStream(), false,
                (sender, cert, chain, errors) => true);

          
            await sslStream.AuthenticateAsClientAsync(ipAddress);

            var serverCertificate = sslStream.RemoteCertificate;
            if (serverCertificate != null)
            {
                var cert2 = new X509Certificate2(serverCertificate);
              
                return cert2.Subject;
            }
        }
        catch
        {
        }
        return "No Domain Found";
    }
}